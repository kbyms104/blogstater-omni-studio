{
  "name": "blogstater-omni-studio",
  "version": "1.0.0",
  "description": "All-in-One Multi-Blog Automation Desktop Studio (Subscription Web AI + Multi-Platform Publisher + Golden Keyword Scout + SEO & Monetization)",
  "license": "MIT",
  "keywords": [
    "electron",
    "react",
    "typescript",
    "playwright",
    "blog",
    "automation",
    "seo",
    "naver-blog",
    "tistory"
  ],
  "main": "dist-electron/main.js",
  "homepage": "https://github.com/kbyms104/blogstater-omni-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbyms104/blogstater-omni-studio.git"
  },
  "bugs": {
    "url": "https://github.com/kbyms104/blogstater-omni-studio/issues"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.blogstater.omnistudio",
    "productName": "BlogStater Omni Studio",
    "icon": "public/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "portable",
        "dir"
      ]
    },
    "portable": {
      "artifactName": "BlogStater-Omni-Studio-Portable.exe"
    }
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "lucide-react": "^0.454.0",
    "marked": "^14.1.3",
    "node-cron": "^3.0.3",
    "playwright": "^1.48.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  }
}
